#ifndef XOMBE_CONFIG_H
#define XOMBE_CONFIG_H

/* generated by CMake: optional parts built, 0 or 1 (xombe.h describes them) */
#cmakedefine01 XOMBE_HAVE_ENCODER
#cmakedefine01 XOMBE_HAVE_DSTAR
/* encoder and decoder kernels: 0 float, 1 fixed point (XOMBE_KERNELS=q15) */
#cmakedefine01 XOMBE_KERNELS_Q15

/* marks the public functions. on Windows: xombe_EXPORTS (set by CMake) while building the DLL, XOMBE_SHARED
   (set by the xombe::xombe target and xombe.pc) in its consumers, neither for the static library */
#if defined(_WIN32) || defined(__CYGWIN__)
#if defined(xombe_EXPORTS)
#define XOMBE_API __declspec(dllexport)
#elif defined(XOMBE_SHARED)
#define XOMBE_API __declspec(dllimport)
#else
#define XOMBE_API
#endif
#elif defined(__GNUC__)
#define XOMBE_API __attribute__((visibility("default")))
#else
#define XOMBE_API
#endif

#endif
